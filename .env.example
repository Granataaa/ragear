# URL del backend UNINETTUNO RAG (FastAPI/Connexion su porta 5005)
RAG_SERVER_URL=http://10.10.11.141:5005

# URL del frontend web RAG Explorer (React su porta 3000)
RAG_FRONTEND_URL=http://10.10.11.141:3000

# Timeout per le richieste verso il server RAG in secondi
RAG_TIMEOUT=25.0

# Numero predefinito di chunk semantici da richiedere
DEFAULT_TOP_K=50

# Sincronizza dinamicamente il catalogo da GET /list all'avvio
SYNC_CATALOG_ON_STARTUP=true

# Intervallo in ore per l'aggiornamento automatico periodico del catalogo (0 = disattivato)
SYNC_CATALOG_INTERVAL_HOURS=24

# Percorso della cache del catalogo corsi
CATALOG_PATH=data/course_catalog.json

# Modalità Debug
DEBUG=false
